---
import BaseLayout from "../layouts/BaseLayout.astro";
import { siteConfig } from "../data/config";

const adminPassword = import.meta.env.PUBLIC_ADMIN_PASSWORD || "change-me";
---

<BaseLayout title="Admin — Portfolio" showChill={false}>
  <main class="admin-page">
    <script type="application/json" id="boot-config" is:inline set:html={JSON.stringify(siteConfig)}></script>

    <!-- LOGIN -->
    <div id="login-gate" class="admin-gate">
      <div class="admin-card admin-card--login">
        <p class="admin-eyebrow">Private</p>
        <h1 class="admin-title">Admin access</h1>
        <p class="admin-copy">Edit colors, projects, links, and your headshot from one place.</p>
        <form id="login-form" class="admin-form" data-admin-password={adminPassword}>
          <label class="admin-label" for="admin-password">Password</label>
          <input
            id="admin-password"
            name="password"
            type="password"
            class="admin-input"
            autocomplete="current-password"
            required
          />
          <p id="login-error" class="admin-error" hidden>
            Wrong password. Check <code>.env</code> and restart <code>npm run dev</code>.
          </p>
          <button type="submit" class="admin-btn admin-btn--primary admin-btn--block">Unlock</button>
        </form>
      </div>
    </div>

    <!-- APP -->
    <div id="admin-app" class="admin-app" hidden>
      <header class="admin-topbar">
        <div class="admin-topbar__brand">
          <p class="admin-eyebrow">Dashboard</p>
          <h1 class="admin-title admin-title--sm">Portfolio admin</h1>
        </div>
        <div class="admin-topbar__actions">
          <button type="button" id="btn-undo" class="admin-btn admin-btn--ghost" title="Undo" disabled>
            Undo
          </button>
          <button type="button" id="btn-redo" class="admin-btn admin-btn--ghost" title="Redo" disabled>
            Redo
          </button>
          <button type="button" id="btn-save" class="admin-btn admin-btn--primary">Save</button>
          <a class="admin-btn admin-btn--ghost" href="/" target="_blank" rel="noopener">View site</a>
          <button type="button" id="btn-logout" class="admin-btn admin-btn--ghost">Log out</button>
        </div>
      </header>

      <nav class="admin-tabs" aria-label="Admin sections">
        <button type="button" class="admin-tab is-active" data-tab="theme">Colors</button>
        <button type="button" class="admin-tab" data-tab="site">Site & photo</button>
        <button type="button" class="admin-tab" data-tab="projects">Projects</button>
        <button type="button" class="admin-tab" data-tab="experience">Experience</button>
      </nav>

      <p id="admin-status" class="admin-status" role="status" aria-live="polite"></p>

      <section class="admin-panel is-active" data-panel="theme">
        <div class="admin-panel__intro">
          <h2 class="admin-section-title">Theme colors</h2>
          <p class="admin-copy">Click a swatch or type a hex — preview updates instantly.</p>
        </div>
        <div class="admin-color-grid" id="theme-fields"></div>
        <div class="admin-theme-preview" aria-hidden="true">
          <span class="preview-chip preview-chip--ink">Text</span>
          <span class="preview-chip preview-chip--bloom">Accent</span>
          <span class="preview-chip preview-chip--muted">Muted</span>
        </div>
      </section>

      <section class="admin-panel" data-panel="site">
        <div class="admin-panel__intro">
          <h2 class="admin-section-title">Site info & headshot</h2>
          <p class="admin-copy">Upload a photo or paste a path. Social links use the hyperlink row below.</p>
        </div>
        <div class="admin-site-layout">
          <div class="admin-upload" id="headshot-upload">
            <img id="headshot-preview" class="admin-upload__preview" alt="Headshot preview" hidden />
            <div class="admin-upload__empty" id="headshot-empty">
              <p class="admin-upload__title">Drop photo here</p>
              <p class="admin-copy">or click to choose a file (JPG / PNG)</p>
            </div>
            <input id="headshot-file" type="file" accept="image/*" class="admin-upload__input" />
          </div>
          <div class="admin-fields" id="site-fields"></div>
        </div>
      </section>

      <section class="admin-panel" data-panel="projects">
        <div class="admin-section-head">
          <div>
            <h2 class="admin-section-title">Projects</h2>
            <p class="admin-copy">Use the link rows to paste Live / GitHub URLs, then Open to test.</p>
          </div>
          <button type="button" id="btn-add-project" class="admin-btn admin-btn--primary">
            + Add project
          </button>
        </div>
        <div id="projects-list" class="admin-list"></div>
      </section>

      <section class="admin-panel" data-panel="experience">
        <div class="admin-section-head">
          <h2 class="admin-section-title">Experience</h2>
          <button type="button" id="btn-add-experience" class="admin-btn admin-btn--ghost">
            + Add role
          </button>
        </div>
        <div id="experience-list" class="admin-list"></div>
      </section>

      <footer class="admin-footer">
        <button type="button" id="btn-download" class="admin-btn admin-btn--ghost">
          Download config JSON
        </button>
        <button type="button" id="btn-reset" class="admin-btn admin-btn--ghost">
          Reset to file defaults
        </button>
      </footer>

      <aside class="admin-note">
        <strong>Tip:</strong> <em>Save</em> keeps edits in this browser. For a permanent live-site update,
        download the JSON and replace <code>public/site-config.json</code> +
        <code>src/data/site-config.json</code>, then rebuild.
      </aside>
    </div>
  </main>
</BaseLayout>

<script>
  import {
    applyTheme,
    downloadConfig,
    loadRuntimeConfig,
    writeLocalConfig,
  } from "../lib/config-client";
  import { ADMIN_SESSION_KEY, CONFIG_STORAGE_KEY } from "../data/types";

  const THEME_LABELS = {
    ink: "Ink (main text)",
    inkMuted: "Muted text",
    mist: "Mist (bg light)",
    mistWarm: "Mist warm (bg)",
    bloom: "Bloom (accent)",
    bloomDeep: "Bloom deep",
    line: "Line / borders",
  };

  const MAX_HISTORY = 40;

  function readBootConfig() {
    const el = document.getElementById("boot-config");
    if (!el?.textContent) return null;
    try {
      return JSON.parse(el.textContent);
    } catch {
      return null;
    }
  }

  function clone(value) {
    return JSON.parse(JSON.stringify(value));
  }

  /** @type {any} */
  let config = readBootConfig();
  /** @type {any[]} */
  let history = [];
  let historyIndex = -1;
  let applyingHistory = false;

  const gate = document.getElementById("login-gate");
  const app = document.getElementById("admin-app");
  const statusEl = document.getElementById("admin-status");
  const loginForm = document.getElementById("login-form");
  const btnUndo = document.getElementById("btn-undo");
  const btnRedo = document.getElementById("btn-redo");

  function setStatus(msg, isError = false) {
    if (!statusEl) return;
    statusEl.textContent = msg;
    statusEl.dataset.error = isError ? "true" : "false";
  }

  function isAuthed() {
    return sessionStorage.getItem(ADMIN_SESSION_KEY) === "1";
  }

  function showApp(show) {
    if (gate) gate.hidden = show;
    if (app) app.hidden = !show;
  }

  function toHex(value) {
    if (/^#[0-9a-fA-F]{6}$/.test(value)) return value;
    return "#121820";
  }

  function escapeHtml(str) {
    return String(str)
      .replaceAll("&", "&amp;")
      .replaceAll("<", "&lt;")
      .replaceAll(">", "&gt;");
  }

  function escapeAttr(str) {
    return escapeHtml(str).replaceAll('"', "&quot;");
  }

  function updateHistoryButtons() {
    if (btnUndo) btnUndo.disabled = historyIndex <= 0;
    if (btnRedo) btnRedo.disabled = historyIndex < 0 || historyIndex >= history.length - 1;
  }

  function pushHistory() {
    if (applyingHistory || !config) return;
    const snapshot = clone(config);
    history = history.slice(0, historyIndex + 1);
    history.push(snapshot);
    if (history.length > MAX_HISTORY) history.shift();
    historyIndex = history.length - 1;
    updateHistoryButtons();
  }

  function restoreHistory(index) {
    if (index < 0 || index >= history.length) return;
    applyingHistory = true;
    historyIndex = index;
    config = clone(history[index]);
    renderAll({ skipHistory: true });
    applyingHistory = false;
    updateHistoryButtons();
    setStatus(index < history.length - 1 ? "Redid change." : "Undid change.");
  }

  function linkRow(label, index, key, value) {
    const safe = escapeAttr(value || "");
    return `
      <div class="link-row">
        <span class="admin-label">${label}</span>
        <div class="link-row__controls">
          <span class="link-row__icon" aria-hidden="true">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <path d="M10 13a5 5 0 0 0 7.54.54l1.92-1.92a5 5 0 0 0-7.07-7.07L10.7 6.24"/>
              <path d="M14 11a5 5 0 0 0-7.54-.54L4.54 12.4a5 5 0 0 0 7.07 7.07l1.69-1.69"/>
            </svg>
          </span>
          <input
            class="admin-input link-row__input"
            type="url"
            placeholder="https://..."
            data-p="${index}"
            data-k="${key}"
            value="${safe}"
          />
          <button type="button" class="admin-btn admin-btn--ghost admin-btn--icon" data-open-link data-p="${index}" data-k="${key}" title="Open link">
            Open
          </button>
        </div>
      </div>
    `;
  }

  function socialLinkRow(label, key, value) {
    return `
      <div class="link-row">
        <span class="admin-label">${label}</span>
        <div class="link-row__controls">
          <span class="link-row__icon" aria-hidden="true">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <path d="M10 13a5 5 0 0 0 7.54.54l1.92-1.92a5 5 0 0 0-7.07-7.07L10.7 6.24"/>
              <path d="M14 11a5 5 0 0 0-7.54-.54L4.54 12.4a5 5 0 0 0 7.07 7.07l1.69-1.69"/>
            </svg>
          </span>
          <input class="admin-input link-row__input" type="text" data-site="${key}" value="${escapeAttr(value || "")}" placeholder="https://... or mailto:..." />
          <button type="button" class="admin-btn admin-btn--ghost admin-btn--icon" data-open-site-link data-k="${key}" title="Open link">
            Open
          </button>
        </div>
      </div>
    `;
  }

  function renderTheme() {
    const wrap = document.getElementById("theme-fields");
    if (!wrap || !config?.theme) return;
    wrap.innerHTML = "";
    for (const [key, label] of Object.entries(THEME_LABELS)) {
      const value = config.theme[key] || "#000000";
      const row = document.createElement("label");
      row.className = "admin-color-row";
      row.innerHTML = `
        <span class="admin-color-row__label">${label}</span>
        <span class="admin-color-controls">
          <input type="color" data-theme="${key}" value="${toHex(value)}" />
          <input type="text" class="admin-input admin-input--sm" data-theme-text="${key}" value="${escapeAttr(value)}" />
        </span>
      `;
      wrap.appendChild(row);
    }

    const onThemeEdit = () => {
      pushHistory();
      applyTheme(config.theme);
    };

    wrap.querySelectorAll("[data-theme]").forEach((input) => {
      input.addEventListener("input", () => {
        const key = input.getAttribute("data-theme");
        const text = wrap.querySelector(`[data-theme-text="${key}"]`);
        config.theme[key] = input.value;
        if (text) text.value = input.value;
        applyTheme(config.theme);
      });
      input.addEventListener("change", onThemeEdit);
    });
    wrap.querySelectorAll("[data-theme-text]").forEach((input) => {
      input.addEventListener("change", () => {
        const key = input.getAttribute("data-theme-text");
        config.theme[key] = input.value;
        const color = wrap.querySelector(`[data-theme="${key}"]`);
        if (color) color.value = toHex(input.value);
        onThemeEdit();
      });
    });
  }

  function updateHeadshotPreview() {
    const img = document.getElementById("headshot-preview");
    const empty = document.getElementById("headshot-empty");
    const src = config?.site?.headshot || "";
    if (img && empty) {
      if (src) {
        img.src = src;
        img.hidden = false;
        empty.hidden = true;
      } else {
        img.hidden = true;
        empty.hidden = false;
      }
    }
  }

  function renderSite() {
    const wrap = document.getElementById("site-fields");
    if (!wrap || !config?.site) return;
    const s = config.site;
    wrap.innerHTML = `
      <label class="admin-field"><span class="admin-label">Name</span>
        <input class="admin-input" data-site="name" type="text" value="${escapeAttr(s.name || "")}" /></label>
      <label class="admin-field"><span class="admin-label">Role</span>
        <input class="admin-input" data-site="role" type="text" value="${escapeAttr(s.role || "")}" /></label>
      <label class="admin-field"><span class="admin-label">Tagline</span>
        <textarea class="admin-input admin-textarea" data-site="tagline" rows="3">${escapeHtml(s.tagline || "")}</textarea></label>
      <label class="admin-field"><span class="admin-label">Tech stack (comma-separated)</span>
        <input class="admin-input" data-site="stack" type="text" value="${escapeAttr((s.stack || []).join(", "))}" /></label>
      <label class="admin-field"><span class="admin-label">Headshot path (or upload on the left)</span>
        <input class="admin-input" data-site="headshot" type="text" value="${escapeAttr(s.headshot || "")}" /></label>
      <label class="admin-field"><span class="admin-label">Browser tab title</span>
        <input class="admin-input" data-site="pageTitle" type="text" value="${escapeAttr(s.pageTitle || "")}" /></label>
      ${socialLinkRow("Email", "email", s.email)}
      ${socialLinkRow("GitHub", "github", s.github)}
      ${socialLinkRow("LinkedIn", "linkedin", s.linkedin)}
    `;

    updateHeadshotPreview();

    wrap.querySelectorAll("[data-site]").forEach((input) => {
      const commit = () => {
        const key = input.getAttribute("data-site");
        const val = input.value;
        if (key === "stack") {
          config.site.stack = val.split(",").map((x) => x.trim()).filter(Boolean);
        } else {
          config.site[key] = val;
        }
        if (key === "headshot") updateHeadshotPreview();
        pushHistory();
      };
      input.addEventListener("change", commit);
      if (input.getAttribute("data-site") === "headshot") {
        input.addEventListener("input", () => {
          config.site.headshot = input.value;
          updateHeadshotPreview();
        });
      }
    });

    wrap.querySelectorAll("[data-open-site-link]").forEach((btn) => {
      btn.addEventListener("click", () => {
        const key = btn.getAttribute("data-k");
        const href = config.site[key];
        if (href && href !== "#") window.open(href, "_blank", "noopener");
        else setStatus("Add a URL first.", true);
      });
    });
  }

  function bindProjectCard(wrap) {
    wrap.querySelectorAll("[data-p]").forEach((input) => {
      if (input.tagName === "BUTTON") return;
      const commit = () => {
        const i = Number(input.getAttribute("data-p"));
        const k = input.getAttribute("data-k");
        if (k === "tags") {
          config.projects[i].tags = input.value.split(",").map((s) => s.trim()).filter(Boolean);
        } else {
          config.projects[i][k] = input.value;
        }
        pushHistory();
      };
      input.addEventListener("change", commit);
    });

    wrap.querySelectorAll("[data-remove-project]").forEach((btn) => {
      btn.addEventListener("click", () => {
        const i = Number(btn.getAttribute("data-remove-project"));
        config.projects.splice(i, 1);
        pushHistory();
        renderProjects();
      });
    });

    wrap.querySelectorAll("[data-open-link]").forEach((btn) => {
      btn.addEventListener("click", () => {
        const i = Number(btn.getAttribute("data-p"));
        const k = btn.getAttribute("data-k");
        const href = config.projects[i]?.[k];
        if (href && href !== "#") window.open(href, "_blank", "noopener");
        else setStatus("Paste a full URL (https://...) first.", true);
      });
    });
  }

  function renderProjects() {
    const wrap = document.getElementById("projects-list");
    if (!wrap || !config?.projects) return;
    wrap.innerHTML = "";
    config.projects.forEach((project, index) => {
      const card = document.createElement("article");
      card.className = "admin-item";
      card.innerHTML = `
        <div class="admin-item-head">
          <h3>${escapeHtml(project.title || `Project ${index + 1}`)}</h3>
          <button type="button" class="admin-btn admin-btn--danger" data-remove-project="${index}">Remove</button>
        </div>
        <label class="admin-field"><span class="admin-label">Title</span>
          <input class="admin-input" data-p="${index}" data-k="title" value="${escapeAttr(project.title || "")}" /></label>
        <label class="admin-field"><span class="admin-label">Description</span>
          <textarea class="admin-input admin-textarea" data-p="${index}" data-k="description" rows="3">${escapeHtml(project.description || "")}</textarea></label>
        <label class="admin-field"><span class="admin-label">Tags (comma-separated)</span>
          <input class="admin-input" data-p="${index}" data-k="tags" value="${escapeAttr((project.tags || []).join(", "))}" /></label>
        <label class="admin-field"><span class="admin-label">Award (optional)</span>
          <input class="admin-input" data-p="${index}" data-k="award" value="${escapeAttr(project.award || "")}" /></label>
        ${linkRow("Live demo link", index, "link", project.link)}
        ${linkRow("GitHub / source link", index, "repo", project.repo)}
      `;
      wrap.appendChild(card);
    });
    bindProjectCard(wrap);
  }

  function renderExperience() {
    const wrap = document.getElementById("experience-list");
    if (!wrap || !config?.experience) return;
    wrap.innerHTML = "";
    config.experience.forEach((item, index) => {
      const card = document.createElement("article");
      card.className = "admin-item";
      card.innerHTML = `
        <div class="admin-item-head">
          <h3>${escapeHtml(item.role || `Role ${index + 1}`)}</h3>
          <button type="button" class="admin-btn admin-btn--danger" data-remove-exp="${index}">Remove</button>
        </div>
        <label class="admin-field"><span class="admin-label">Role</span>
          <input class="admin-input" data-e="${index}" data-k="role" value="${escapeAttr(item.role || "")}" /></label>
        <label class="admin-field"><span class="admin-label">Organization</span>
          <input class="admin-input" data-e="${index}" data-k="org" value="${escapeAttr(item.org || "")}" /></label>
        <label class="admin-field"><span class="admin-label">Detail</span>
          <textarea class="admin-input admin-textarea" data-e="${index}" data-k="detail" rows="3">${escapeHtml(item.detail || "")}</textarea></label>
      `;
      wrap.appendChild(card);
    });

    wrap.querySelectorAll("[data-e]").forEach((input) => {
      input.addEventListener("change", () => {
        const i = Number(input.getAttribute("data-e"));
        const k = input.getAttribute("data-k");
        config.experience[i][k] = input.value;
        pushHistory();
      });
    });
    wrap.querySelectorAll("[data-remove-exp]").forEach((btn) => {
      btn.addEventListener("click", () => {
        const i = Number(btn.getAttribute("data-remove-exp"));
        config.experience.splice(i, 1);
        pushHistory();
        renderExperience();
      });
    });
  }

  function renderAll(opts = {}) {
    if (!config) {
      setStatus("Could not load site config.", true);
      return;
    }
    renderTheme();
    renderSite();
    renderProjects();
    renderExperience();
    applyTheme(config.theme);
    if (!opts.skipHistory && history.length === 0) {
      history = [clone(config)];
      historyIndex = 0;
      updateHistoryButtons();
    }
  }

  function setupHeadshotUpload() {
    const zone = document.getElementById("headshot-upload");
    const fileInput = document.getElementById("headshot-file");
    if (!zone || !fileInput) return;

    const handleFile = (file) => {
      if (!file || !file.type.startsWith("image/")) {
        setStatus("Please choose an image file.", true);
        return;
      }
      const reader = new FileReader();
      reader.onload = () => {
        config.site.headshot = String(reader.result || "");
        updateHeadshotPreview();
        const pathInput = document.querySelector('[data-site="headshot"]');
        if (pathInput) pathInput.value = "(uploaded image — saved in browser)";
        pushHistory();
        setStatus(
          "Photo uploaded for preview in this browser. For the live site, also put the file in public/images/headshot.jpg.",
        );
      };
      reader.readAsDataURL(file);
    };

    zone.addEventListener("click", () => fileInput.click());
    fileInput.addEventListener("change", () => {
      const file = fileInput.files?.[0];
      if (file) handleFile(file);
    });
    zone.addEventListener("dragover", (e) => {
      e.preventDefault();
      zone.classList.add("is-dragover");
    });
    zone.addEventListener("dragleave", () => zone.classList.remove("is-dragover"));
    zone.addEventListener("drop", (e) => {
      e.preventDefault();
      zone.classList.remove("is-dragover");
      const file = e.dataTransfer?.files?.[0];
      if (file) handleFile(file);
    });
  }

  async function unlock() {
    showApp(true);
    try {
      config = (await loadRuntimeConfig()) || config || readBootConfig();
    } catch {
      config = config || readBootConfig();
    }
    history = [];
    historyIndex = -1;
    renderAll();
    setupHeadshotUpload();
    setStatus("Unlocked. Use Undo / Redo anytime while editing.");
  }

  async function boot() {
    try {
      config = (await loadRuntimeConfig()) || readBootConfig();
    } catch {
      config = readBootConfig();
    }
    if (isAuthed()) await unlock();
    else showApp(false);
  }

  loginForm?.addEventListener("submit", (e) => {
    e.preventDefault();
    const expected = loginForm.getAttribute("data-admin-password") || "change-me";
    const input = document.getElementById("admin-password");
    const err = document.getElementById("login-error");
    const value = (input?.value || "").trim();
    if (value === expected.trim()) {
      sessionStorage.setItem(ADMIN_SESSION_KEY, "1");
      if (err) err.hidden = true;
      void unlock();
    } else if (err) {
      err.hidden = false;
    }
  });

  document.getElementById("btn-logout")?.addEventListener("click", () => {
    sessionStorage.removeItem(ADMIN_SESSION_KEY);
    showApp(false);
  });

  btnUndo?.addEventListener("click", () => restoreHistory(historyIndex - 1));
  btnRedo?.addEventListener("click", () => restoreHistory(historyIndex + 1));

  document.querySelectorAll(".admin-tab").forEach((tab) => {
    tab.addEventListener("click", () => {
      const id = tab.getAttribute("data-tab");
      document.querySelectorAll(".admin-tab").forEach((t) => t.classList.remove("is-active"));
      document.querySelectorAll(".admin-panel").forEach((p) => p.classList.remove("is-active"));
      tab.classList.add("is-active");
      document.querySelector(`[data-panel="${id}"]`)?.classList.add("is-active");
    });
  });

  document.getElementById("btn-add-project")?.addEventListener("click", () => {
    config.projects.push({
      title: "New project",
      description: "",
      tags: [],
      award: "",
      link: "",
      repo: "",
    });
    pushHistory();
    renderProjects();
    setStatus("Project added — paste your Live / GitHub links in the hyperlink rows.");
  });

  document.getElementById("btn-add-experience")?.addEventListener("click", () => {
    config.experience.push({ role: "New role", org: "", detail: "" });
    pushHistory();
    renderExperience();
  });

  document.getElementById("btn-save")?.addEventListener("click", () => {
    writeLocalConfig(config);
    applyTheme(config.theme);
    setStatus("Saved! Open the homepage (or refresh it) — your edits should show there now.");
  });

  document.getElementById("btn-download")?.addEventListener("click", () => {
    downloadConfig(config);
    setStatus("Downloaded site-config.json.");
  });

  document.getElementById("btn-reset")?.addEventListener("click", async () => {
    localStorage.removeItem(CONFIG_STORAGE_KEY);
    const res = await fetch("/site-config.json", { cache: "no-store" });
    config = await res.json();
    history = [];
    historyIndex = -1;
    renderAll();
    setStatus("Reset to public/site-config.json defaults.");
  });

  document.addEventListener("keydown", (e) => {
