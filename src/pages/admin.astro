---
import BaseLayout from "../layouts/BaseLayout.astro";
import { siteConfig } from "../data/config";

const adminPassword = import.meta.env.PUBLIC_ADMIN_PASSWORD || "change-me";
---

<BaseLayout title="Admin — Portfolio" showChill={false}>
  <main class="admin-page">
    <script type="application/json" id="boot-config" is:inline set:html={JSON.stringify(siteConfig)}></script>

    <div id="login-gate" class="admin-gate">
      <div class="admin-card">
        <p class="admin-eyebrow">Private</p>
        <h1 class="admin-title">Admin access</h1>
        <p class="admin-copy">
          Enter your password to edit site content, colors, and projects.
        </p>
        <form id="login-form" class="admin-form" data-admin-password={adminPassword}>
          <label class="admin-label" for="admin-password">Password</label>
          <input
            id="admin-password"
            name="password"
            type="password"
            class="admin-input"
            autocomplete="current-password"
            required
          />
          <p id="login-error" class="admin-error" hidden>Wrong password. Check .env and restart the dev server.</p>
          <button type="submit" class="admin-btn admin-btn--primary">Unlock</button>
        </form>
        <p class="admin-hint">
          Password comes from <code>PUBLIC_ADMIN_PASSWORD</code> in your <code>.env</code> file.
          After changing it, restart <code>npm run dev</code>.
        </p>
      </div>
    </div>

    <div id="admin-app" class="admin-app" hidden>
      <header class="admin-top">
        <div>
          <p class="admin-eyebrow">Dashboard</p>
          <h1 class="admin-title">Edit portfolio</h1>
        </div>
        <div class="admin-top-actions">
          <a class="admin-btn admin-btn--ghost" href="/">View site</a>
          <button type="button" id="btn-logout" class="admin-btn admin-btn--ghost">
            Log out
          </button>
        </div>
      </header>

      <nav class="admin-tabs" aria-label="Admin sections">
        <button type="button" class="admin-tab is-active" data-tab="theme">Colors</button>
        <button type="button" class="admin-tab" data-tab="site">Site info</button>
        <button type="button" class="admin-tab" data-tab="projects">Projects</button>
        <button type="button" class="admin-tab" data-tab="experience">Experience</button>
      </nav>

      <p id="admin-status" class="admin-status" role="status" aria-live="polite"></p>

      <section class="admin-panel is-active" data-panel="theme">
        <h2 class="admin-section-title">Theme colors</h2>
        <p class="admin-copy">Changes preview live on this page. Save to keep them.</p>
        <div class="admin-color-grid" id="theme-fields"></div>
      </section>

      <section class="admin-panel" data-panel="site">
        <h2 class="admin-section-title">Site info</h2>
        <div class="admin-fields" id="site-fields"></div>
      </section>

      <section class="admin-panel" data-panel="projects">
        <div class="admin-section-head">
          <h2 class="admin-section-title">Projects</h2>
          <button type="button" id="btn-add-project" class="admin-btn admin-btn--ghost">
            Add project
          </button>
        </div>
        <div id="projects-list" class="admin-list"></div>
      </section>

      <section class="admin-panel" data-panel="experience">
        <div class="admin-section-head">
          <h2 class="admin-section-title">Experience</h2>
          <button type="button" id="btn-add-experience" class="admin-btn admin-btn--ghost">
            Add role
          </button>
        </div>
        <div id="experience-list" class="admin-list"></div>
      </section>

      <footer class="admin-footer">
        <button type="button" id="btn-save" class="admin-btn admin-btn--primary">
          Save changes
        </button>
        <button type="button" id="btn-download" class="admin-btn admin-btn--ghost">
          Download site-config.json
        </button>
        <button type="button" id="btn-reset" class="admin-btn admin-btn--ghost">
          Reset to file defaults
        </button>
      </footer>

      <aside class="admin-note">
        <strong>How saving works:</strong> Save stores edits in this browser and applies
        colors immediately. For permanent updates on the live site, click
        <em>Download site-config.json</em>, replace
        <code>public/site-config.json</code> (and
        <code>src/data/site-config.json</code>), then rebuild / redeploy.
      </aside>
    </div>
  </main>
</BaseLayout>

<script>
  import {
    applyTheme,
    downloadConfig,
    loadRuntimeConfig,
    writeLocalConfig,
  } from "../lib/config-client";
  import { ADMIN_SESSION_KEY, CONFIG_STORAGE_KEY } from "../data/types";

  const THEME_LABELS = {
    ink: "Ink (main text)",
    inkMuted: "Muted text",
    mist: "Mist (bg light)",
    mistWarm: "Mist warm (bg)",
    bloom: "Bloom (accent)",
    bloomDeep: "Bloom deep",
    line: "Line / borders",
  };

  const SITE_FIELDS = [
    ["name", "Name"],
    ["role", "Role"],
    ["tagline", "Tagline"],
    ["stack", "Tech stack (comma-separated)"],
    ["headshot", "Headshot path"],
    ["email", "Email (mailto:...)"],
    ["github", "GitHub URL"],
    ["linkedin", "LinkedIn URL"],
    ["pageTitle", "Browser tab title"],
  ];

  function readBootConfig() {
    const el = document.getElementById("boot-config");
    if (!el?.textContent) return null;
    try {
      return JSON.parse(el.textContent);
    } catch {
      return null;
    }
  }

  /** @type {any} */
  let config = readBootConfig();
  const gate = document.getElementById("login-gate");
  const app = document.getElementById("admin-app");
  const statusEl = document.getElementById("admin-status");
  const loginForm = document.getElementById("login-form");

  function setStatus(msg, isError = false) {
    if (!statusEl) return;
    statusEl.textContent = msg;
    statusEl.dataset.error = isError ? "true" : "false";
  }

  function isAuthed() {
    return sessionStorage.getItem(ADMIN_SESSION_KEY) === "1";
  }

  function showApp(show) {
    if (gate) gate.hidden = show;
    if (app) app.hidden = !show;
  }

  function toHex(value) {
    if (/^#[0-9a-fA-F]{6}$/.test(value)) return value;
    return "#121820";
  }

  function escapeHtml(str) {
    return String(str)
      .replaceAll("&", "&amp;")
      .replaceAll("<", "&lt;")
      .replaceAll(">", "&gt;");
  }

  function escapeAttr(str) {
    return escapeHtml(str).replaceAll('"', "&quot;");
  }

  function renderTheme() {
    const wrap = document.getElementById("theme-fields");
    if (!wrap || !config?.theme) return;
    wrap.innerHTML = "";
    for (const [key, label] of Object.entries(THEME_LABELS)) {
      const value = config.theme[key] || "#000000";
      const row = document.createElement("label");
      row.className = "admin-color-row";
      row.innerHTML = `
        <span>${label}</span>
        <span class="admin-color-controls">
          <input type="color" data-theme="${key}" value="${toHex(value)}" />
          <input type="text" class="admin-input admin-input--sm" data-theme-text="${key}" value="${escapeAttr(value)}" />
        </span>
      `;
      wrap.appendChild(row);
    }
    wrap.querySelectorAll("[data-theme]").forEach((input) => {
      input.addEventListener("input", () => {
        const key = input.getAttribute("data-theme");
        const text = wrap.querySelector(`[data-theme-text="${key}"]`);
        config.theme[key] = input.value;
        if (text) text.value = input.value;
        applyTheme(config.theme);
      });
    });
    wrap.querySelectorAll("[data-theme-text]").forEach((input) => {
      input.addEventListener("change", () => {
        const key = input.getAttribute("data-theme-text");
        config.theme[key] = input.value;
        const color = wrap.querySelector(`[data-theme="${key}"]`);
        if (color) color.value = toHex(input.value);
        applyTheme(config.theme);
      });
    });
  }

  function renderSite() {
    const wrap = document.getElementById("site-fields");
    if (!wrap || !config?.site) return;
    wrap.innerHTML = "";
    for (const [key, label] of SITE_FIELDS) {
      const raw = config.site[key];
      const value = Array.isArray(raw) ? raw.join(", ") : raw || "";
      const isLong = key === "tagline";
      const field = document.createElement("label");
      field.className = "admin-field";
      field.innerHTML = `
        <span class="admin-label">${label}</span>
        ${
          isLong
            ? `<textarea class="admin-input admin-textarea" data-site="${key}" rows="3">${escapeHtml(value)}</textarea>`
            : `<input class="admin-input" data-site="${key}" type="text" value="${escapeAttr(value)}" />`
        }
      `;
      wrap.appendChild(field);
    }
    wrap.querySelectorAll("[data-site]").forEach((input) => {
      input.addEventListener("input", () => {
        const key = input.getAttribute("data-site");
        const val = input.value;
        if (key === "stack") {
          config.site.stack = val
            .split(",")
            .map((s) => s.trim())
            .filter(Boolean);
        } else {
          config.site[key] = val;
        }
      });
    });
  }

  function renderProjects() {
    const wrap = document.getElementById("projects-list");
    if (!wrap || !config?.projects) return;
    wrap.innerHTML = "";
    config.projects.forEach((project, index) => {
      const card = document.createElement("article");
      card.className = "admin-item";
      card.innerHTML = `
        <div class="admin-item-head">
          <h3>Project ${index + 1}</h3>
          <button type="button" class="admin-btn admin-btn--danger" data-remove-project="${index}">Remove</button>
        </div>
        <label class="admin-field"><span class="admin-label">Title</span>
          <input class="admin-input" data-p="${index}" data-k="title" value="${escapeAttr(project.title || "")}" /></label>
        <label class="admin-field"><span class="admin-label">Description</span>
          <textarea class="admin-input admin-textarea" data-p="${index}" data-k="description" rows="3">${escapeHtml(project.description || "")}</textarea></label>
        <label class="admin-field"><span class="admin-label">Tags (comma-separated)</span>
          <input class="admin-input" data-p="${index}" data-k="tags" value="${escapeAttr((project.tags || []).join(", "))}" /></label>
        <label class="admin-field"><span class="admin-label">Award (optional)</span>
          <input class="admin-input" data-p="${index}" data-k="award" value="${escapeAttr(project.award || "")}" /></label>
        <div class="admin-row-2">
          <label class="admin-field"><span class="admin-label">Live link</span>
            <input class="admin-input" data-p="${index}" data-k="link" value="${escapeAttr(project.link || "")}" /></label>
          <label class="admin-field"><span class="admin-label">Repo link</span>
            <input class="admin-input" data-p="${index}" data-k="repo" value="${escapeAttr(project.repo || "")}" /></label>
        </div>
      `;
      wrap.appendChild(card);
    });

    wrap.querySelectorAll("[data-p]").forEach((input) => {
      input.addEventListener("input", () => {
        const i = Number(input.getAttribute("data-p"));
        const k = input.getAttribute("data-k");
        if (k === "tags") {
          config.projects[i].tags = input.value
            .split(",")
            .map((s) => s.trim())
            .filter(Boolean);
        } else {
          config.projects[i][k] = input.value;
        }
      });
    });

    wrap.querySelectorAll("[data-remove-project]").forEach((btn) => {
      btn.addEventListener("click", () => {
        const i = Number(btn.getAttribute("data-remove-project"));
        config.projects.splice(i, 1);
        renderProjects();
      });
    });
  }

  function renderExperience() {
    const wrap = document.getElementById("experience-list");
    if (!wrap || !config?.experience) return;
    wrap.innerHTML = "";
    config.experience.forEach((item, index) => {
      const card = document.createElement("article");
      card.className = "admin-item";
      card.innerHTML = `
        <div class="admin-item-head">
          <h3>Role ${index + 1}</h3>
          <button type="button" class="admin-btn admin-btn--danger" data-remove-exp="${index}">Remove</button>
        </div>
        <label class="admin-field"><span class="admin-label">Role</span>
          <input class="admin-input" data-e="${index}" data-k="role" value="${escapeAttr(item.role || "")}" /></label>
        <label class="admin-field"><span class="admin-label">Organization</span>
          <input class="admin-input" data-e="${index}" data-k="org" value="${escapeAttr(item.org || "")}" /></label>
        <label class="admin-field"><span class="admin-label">Detail</span>
          <textarea class="admin-input admin-textarea" data-e="${index}" data-k="detail" rows="3">${escapeHtml(item.detail || "")}</textarea></label>
      `;
      wrap.appendChild(card);
    });

    wrap.querySelectorAll("[data-e]").forEach((input) => {
      input.addEventListener("input", () => {
        const i = Number(input.getAttribute("data-e"));
        const k = input.getAttribute("data-k");
        config.experience[i][k] = input.value;
      });
    });

    wrap.querySelectorAll("[data-remove-exp]").forEach((btn) => {
      btn.addEventListener("click", () => {
        const i = Number(btn.getAttribute("data-remove-exp"));
        config.experience.splice(i, 1);
        renderExperience();
      });
    });
  }

  function renderAll() {
    if (!config) {
      setStatus("Could not load site config.", true);
      return;
    }
    renderTheme();
    renderSite();
    renderProjects();
    renderExperience();
    applyTheme(config.theme);
  }

  async function unlock() {
    showApp(true);
    try {
      config = (await loadRuntimeConfig()) || config || readBootConfig();
    } catch {
      config = config || readBootConfig();
    }
    renderAll();
    setStatus("Unlocked. Edit and save when ready.");
  }

  async function boot() {
    try {
      config = (await loadRuntimeConfig()) || readBootConfig();
    } catch {
      config = readBootConfig();
    }
    if (isAuthed()) {
      await unlock();
    } else {
      showApp(false);
    }
  }

  loginForm?.addEventListener("submit", (e) => {
    e.preventDefault();
    const expected = loginForm.getAttribute("data-admin-password") || "change-me";
    const input = document.getElementById("admin-password");
    const err = document.getElementById("login-error");
    const value = (input?.value || "").trim();
    if (value === expected.trim()) {
      sessionStorage.setItem(ADMIN_SESSION_KEY, "1");
      if (err) err.hidden = true;
      void unlock();
    } else {
      if (err) err.hidden = false;
    }
  });

  document.getElementById("btn-logout")?.addEventListener("click", () => {
    sessionStorage.removeItem(ADMIN_SESSION_KEY);
    showApp(false);
  });

  document.querySelectorAll(".admin-tab").forEach((tab) => {
    tab.addEventListener("click", () => {
      const id = tab.getAttribute("data-tab");
      document.querySelectorAll(".admin-tab").forEach((t) => t.classList.remove("is-active"));
      document.querySelectorAll(".admin-panel").forEach((p) => p.classList.remove("is-active"));
      tab.classList.add("is-active");
      document.querySelector(`[data-panel="${id}"]`)?.classList.add("is-active");
    });
  });

  document.getElementById("btn-add-project")?.addEventListener("click", () => {
    config.projects.push({
      title: "New project",
      description: "",
      tags: [],
      award: "",
      link: "#",
      repo: "#",
    });
    renderProjects();
  });

  document.getElementById("btn-add-experience")?.addEventListener("click", () => {
    config.experience.push({
      role: "New role",
      org: "",
      detail: "",
    });
    renderExperience();
  });

  document.getElementById("btn-save")?.addEventListener("click", () => {
    writeLocalConfig(config);
    applyTheme(config.theme);
    setStatus(
      "Saved in this browser. Colors apply site-wide here. Download JSON to make it permanent.",
    );
  });

  document.getElementById("btn-download")?.addEventListener("click", () => {
    downloadConfig(config);
    setStatus(
      "Downloaded site-config.json — replace public/site-config.json and src/data/site-config.json, then rebuild.",
    );
  });

  document.getElementById("btn-reset")?.addEventListener("click", async () => {
    localStorage.removeItem(CONFIG_STORAGE_KEY);
    const res = await fetch("/site-config.json", { cache: "no-store" });
    config = await res.json();
    renderAll();
    setStatus("Reset to public/site-config.json defaults.");
  });

  void boot();
</script>

<style>
  .admin-page {
    min-height: 100vh;
    padding: 2rem 1.25rem 4rem;
  }

  .admin-gate {
    min-height: 70vh;
    display: grid;
    place-items: center;
  }

  .admin-card,
  .admin-app {
    width: min(920px, 100%);
    margin-inline: auto;
  }

  .admin-card {
    padding: 2rem;
    border: 1px solid color-mix(in srgb, var(--color-line) 80%, transparent);
    background: color-mix(in srgb, white 72%, var(--color-mist-warm));
    backdrop-filter: blur(10px);
  }

  .admin-eyebrow {
    margin: 0;
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--color-bloom);
  }

  .admin-title {
    margin: 0.5rem 0 0;
    font-family: var(--font-display);
    font-size: clamp(1.75rem, 4vw, 2.5rem);
    line-height: 1.1;
    color: var(--color-ink);
  }

  .admin-copy,
  .admin-hint,
  .admin-note {
    color: var(--color-ink-muted);
    line-height: 1.5;
  }

  .admin-hint,
  .admin-note {
    font-size: 0.9rem;
  }

  .admin-hint code,
  .admin-note code {
    font-size: 0.85em;
    padding: 0.1em 0.35em;
    background: color-mix(in srgb, var(--color-mist) 70%, white);
  }

  .admin-form {
    display: grid;
    gap: 0.65rem;
    margin-top: 1.5rem;
  }

  .admin-label {
    display: block;
    font-size: 0.8rem;
    font-weight: 600;
    color: var(--color-ink);
    margin-bottom: 0.35rem;
  }

  .admin-input,
  .admin-textarea {
    width: 100%;
    box-sizing: border-box;
    border: 1px solid var(--color-line);
    background: white;
    color: var(--color-ink);
    padding: 0.65rem 0.75rem;
    font: inherit;
  }

  .admin-input--sm {
    width: 7.5rem;
    padding: 0.4rem 0.5rem;
  }

  .admin-textarea {
    resize: vertical;
  }

  .admin-error {
    color: #b42318;
    margin: 0;
    font-size: 0.9rem;
  }

  .admin-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.35rem;
    border: 1px solid var(--color-line);
    background: white;
    color: var(--color-ink);
    font-family: var(--font-display);
    font-size: 0.8rem;
    font-weight: 650;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    text-decoration: none;
    padding: 0.7rem 1rem;
    cursor: pointer;
  }

  .admin-btn--primary {
    background: var(--color-bloom);
    border-color: var(--color-bloom);
    color: white;
  }

  .admin-btn--ghost:hover {
    border-color: var(--color-bloom);
    color: var(--color-bloom-deep);
  }

  .admin-btn--danger {
    border-color: #f0c0ba;
    color: #b42318;
    background: #fff6f5;
  }

  .admin-top {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 1rem;
    margin-bottom: 1.5rem;
  }

  .admin-top-actions {
    display: flex;
    gap: 0.5rem;
    align-items: flex-start;
  }

  .admin-tabs {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
    margin-bottom: 1rem;
  }

  .admin-tab {
    border: 1px solid var(--color-line);
    background: transparent;
    color: var(--color-ink-muted);
    padding: 0.55rem 0.9rem;
    font-family: var(--font-display);
    font-size: 0.8rem;
    font-weight: 650;
    cursor: pointer;
  }

  .admin-tab.is-active {
    background: var(--color-ink);
    border-color: var(--color-ink);
    color: white;
  }

  .admin-status {
    min-height: 1.25rem;
    margin: 0 0 1rem;
    color: var(--color-bloom-deep);
    font-size: 0.92rem;
  }

  .admin-status[data-error="true"] {
    color: #b42318;
  }

  .admin-panel {
    display: none;
    padding: 1.25rem;
    border: 1px solid var(--color-line);
    background: color-mix(in srgb, white 78%, var(--color-mist-warm));
    margin-bottom: 1rem;
  }

  .admin-panel.is-active {
    display: block;
  }

  .admin-section-title {
    margin: 0;
    font-family: var(--font-display);
    font-size: 1.25rem;
    color: var(--color-ink);
  }

  .admin-section-head {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 0.75rem;
    margin-bottom: 1rem;
  }

  .admin-color-grid,
  .admin-fields,
  .admin-list {
    display: grid;
    gap: 0.85rem;
    margin-top: 1rem;
  }

  .admin-color-row {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 1rem;
    font-size: 0.92rem;
    color: var(--color-ink);
  }

  .admin-color-controls {
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }

  .admin-field {
    display: block;
  }

  .admin-item {
    border: 1px solid var(--color-line);
    padding: 1rem;
    background: white;
    display: grid;
    gap: 0.75rem;
  }

  .admin-item-head {
    display: flex;
    justify-content: space-between;
    align-items: center;
  }

  .admin-item-head h3 {
    margin: 0;
    font-family: var(--font-display);
    font-size: 1rem;
  }

  .admin-row-2 {
    display: grid;
    gap: 0.75rem;
  }

  @media (min-width: 720px) {
    .admin-row-2 {
      grid-template-columns: 1fr 1fr;
    }
  }

  .admin-footer {
    display: flex;
    flex-wrap: wrap;
    gap: 0.55rem;
    margin: 1rem 0;
  }

  .admin-note {
    padding: 1rem;
    border-left: 3px solid var(--color-bloom);
    background: color-mix(in srgb, var(--color-mist) 55%, white);
  }
</style>
