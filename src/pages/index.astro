---
import Layout from "../layouts/Layout.astro";
import Nav from "../components/Nav.astro";
import { site } from "../data/site";

const links = [
  {
    href: "/about",
    label: "About",
    hint: "Who I am & how I work",
  },
  {
    href: "/projects",
    label: "Projects",
    hint: "Things I’ve built and shipped",
  },
  {
    href: "/experience",
    label: "Experience",
    hint: "Hackathons, roles & certificates",
  },
];
---

<Layout>
  <Nav />
  <main class="home">
    <div class="home__inner">
      <p class="home__eyebrow animate-hero-rise">Portfolio</p>
      <h1 class="home__title animate-hero-rise animate-hero-rise-delay-1">
        {site.name}
      </h1>
      <p class="home__subtitle animate-hero-rise animate-hero-rise-delay-2">
        {site.role.trim()} — building with {site.stack.join(", ")}.
      </p>

      <ul class="home__paths animate-hero-rise animate-hero-rise-delay-3" aria-label="Explore">
        {
          links.map((link) => (
            <li>
              <a href={link.href} class="path-card" data-magnetic>
                <span class="path-card__label">{link.label}</span>
                <span class="path-card__hint">{link.hint}</span>
                <span class="path-card__arrow" aria-hidden="true">→</span>
              </a>
            </li>
          ))
        }
      </ul>

      <p class="home__alt animate-hero-rise animate-hero-rise-delay-3">
        <a href="/new-tab">Try New Tab view →</a>
      </p>
    </div>
  </main>
</Layout>

<style>
  .home {
    position: relative;
    display: flex;
    min-height: 100svh;
    flex-direction: column;
    justify-content: center;
    padding: 6.5rem 1.5rem 3.5rem;
  }

  @media (min-width: 768px) {
    .home {
      padding: 7.5rem 2rem 4rem;
    }
  }

  .home__inner {
    margin-inline: auto;
    width: 100%;
    max-width: 48rem;
  }

  .home__eyebrow {
    margin: 0;
    font-family: var(--font-body);
    font-size: 0.8rem;
    font-weight: 650;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--color-bloom);
  }

  .home__title {
    margin: 1.1rem 0 0;
    font-family: var(--font-display);
    font-size: clamp(2.75rem, 11vw, 5.75rem);
    font-weight: 700;
    line-height: 0.95;
    letter-spacing: -0.03em;
    color: var(--color-ink);
  }

  .home__subtitle {
    margin: 1.35rem 0 0;
    max-width: 28rem;
    font-family: var(--font-display);
    font-size: clamp(1.05rem, 2.4vw, 1.25rem);
    font-weight: 500;
    line-height: 1.45;
    color: var(--color-ink-muted);
  }

  .home__paths {
    margin: 2.75rem 0 0;
    padding: 0;
    list-style: none;
    display: grid;
    gap: 0.85rem;
  }

  @media (min-width: 640px) {
    .home__paths {
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: 1rem;
    }
  }

  .path-card {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: 0.45rem;
    min-height: 7.5rem;
    padding: 1.15rem 1.2rem 1.25rem;
    border: 1px solid color-mix(in srgb, var(--color-line) 85%, transparent);
    border-radius: 0.9rem;
    background: color-mix(in srgb, white 78%, var(--color-mist-warm));
    text-decoration: none;
    overflow: hidden;
    transition:
      transform 0.25s ease,
      border-color 0.25s ease,
      box-shadow 0.25s ease,
      background 0.25s ease;
  }

  .path-card::before {
    content: "";
    position: absolute;
    inset: auto 0 0;
    height: 3px;
    background: var(--color-bloom);
    transform: scaleX(0);
    transform-origin: left;
    transition: transform 0.35s cubic-bezier(0.22, 1, 0.36, 1);
  }

  .path-card:hover,
  .path-card:focus-visible {
    border-color: color-mix(in srgb, var(--color-bloom) 40%, var(--color-line));
    background: color-mix(in srgb, white 92%, #ffe8e6);
    box-shadow: 0 18px 40px rgba(18, 24, 32, 0.1);
    outline: none;
  }

  .path-card:hover::before,
  .path-card:focus-visible::before {
    transform: scaleX(1);
  }

  .path-card__label {
    font-family: var(--font-display);
    font-size: 1.15rem;
    font-weight: 700;
    color: var(--color-ink);
  }

  .path-card__hint {
    font-size: 0.9rem;
    line-height: 1.4;
    color: var(--color-ink-muted);
    max-width: 14rem;
  }

  .path-card__arrow {
    margin-top: auto;
    align-self: flex-end;
    font-size: 1.15rem;
    color: var(--color-bloom);
    transform: translateX(0);
    transition: transform 0.25s ease;
  }

  .path-card:hover .path-card__arrow,
  .path-card:focus-visible .path-card__arrow {
    transform: translateX(4px);
  }

  .home__alt {
    margin: 1.75rem 0 0;
    font-size: 0.9rem;
  }

  .home__alt a {
    color: var(--color-ink-muted);
    text-decoration: none;
    font-weight: 550;
    transition: color 0.2s ease;
  }

  .home__alt a:hover {
    color: var(--color-bloom);
  }
</style>
