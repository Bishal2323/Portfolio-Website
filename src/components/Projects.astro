---
import { projects, weekendDev } from "../data/projects";

const slug = (title: string) =>
  title
    .toLowerCase()
    .replace(/[^a-z0-9]+/g, "-")
    .replace(/(^-|-$)/g, "");
---

<section
  id="projects"
  class="border-t border-line/60 py-20 md:py-28"
  aria-labelledby="projects-heading"
>
  <div class="mx-auto max-w-5xl px-6 md:px-8">
    <div class="reveal">
      <h2
        id="projects-heading"
        class="font-display text-sm font-semibold uppercase tracking-[0.18em] text-ink-muted"
      >
        Projects
      </h2>
      <p class="mt-4 max-w-lg text-base text-ink-muted md:text-lg">
        Selected work from building, competing, and collaborating on campus.
      </p>
    </div>

    <ul class="mt-14 divide-y divide-line/70">
      {
        projects.map((project, index) => (
          <li
            id={slug(project.title)}
            class={`project-item reveal py-10 md:py-12`}
            style={`transition-delay: ${index * 80}ms`}
          >
            <article class="grid gap-6 md:grid-cols-[minmax(0,1.1fr)_minmax(0,1.4fr)] md:gap-12">
              <div>
                <p class="font-display text-xs font-semibold uppercase tracking-[0.2em] text-ink-muted">
                  {String(index + 1).padStart(2, "0")}
                </p>
                <h3 class="mt-3 font-display text-3xl font-bold tracking-tight text-ink md:text-4xl">
                  {project.link && project.link !== "#" ? (
                    <a
                      href={project.link}
                      class="project-link focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-bloom"
                    >
                      <span class="project-title">{project.title}</span>
                    </a>
                  ) : (
                    <span class="project-title">{project.title}</span>
                  )}
                </h3>
                {project.award && (
                  <p class="mt-3 text-sm font-semibold text-ink-muted">{project.award}</p>
                )}
              </div>
              <div class="flex flex-col justify-center">
                <p class="text-base leading-relaxed text-ink-muted md:text-lg">
                  {project.description}
                </p>
                <ul class="mt-5 flex flex-wrap gap-x-5 gap-y-2" aria-label="Technologies">
                  {project.tags.map((tag) => (
                    <li class="text-sm text-ink">{tag}</li>
                  ))}
                </ul>
                {(project.repo || project.link) && (
                  <div class="mt-6 flex flex-wrap gap-5 text-sm font-semibold">
                    {project.link && project.link !== "#" && (
                      <a href={project.link} class="link-underline font-semibold">
                        Live demo
                      </a>
                    )}
                    {project.repo && project.repo !== "#" && (
                      <a href={project.repo} class="link-underline font-semibold">
                        Source
                      </a>
                    )}
                  </div>
                )}
              </div>
            </article>
          </li>
        ))
      }
    </ul>
  </div>
</section>

{
  weekendDev.length > 0 && (
    <section
      id="weekend-dev"
      class="border-t border-line/60 py-20 md:py-28"
      aria-labelledby="weekend-dev-heading"
    >
      <div class="mx-auto max-w-5xl px-6 md:px-8">
        <div class="reveal">
          <h2
            id="weekend-dev-heading"
            class="font-display text-sm font-semibold uppercase tracking-[0.18em] text-ink-muted"
          >
            Weekend Dev
          </h2>
          <p class="mt-4 max-w-lg text-base text-ink-muted md:text-lg">
            Small builds and experiments shipped over a weekend.
          </p>
        </div>

        <ul class="mt-14 divide-y divide-line/70">
          {weekendDev.map((project, index) => (
            <li
              id={slug(project.title)}
              class={`project-item reveal py-10 md:py-12`}
              style={`transition-delay: ${index * 80}ms`}
            >
              <article class="grid gap-6 md:grid-cols-[minmax(0,1.1fr)_minmax(0,1.4fr)] md:gap-12">
                <div>
                  <p class="font-display text-xs font-semibold uppercase tracking-[0.2em] text-ink-muted">
                    {String(index + 1).padStart(2, "0")}
                  </p>
                  <h3 class="mt-3 font-display text-3xl font-bold tracking-tight text-ink md:text-4xl">
                    {project.link && project.link !== "#" ? (
                      <a
                        href={project.link}
                        class="project-link focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-bloom"
                      >
                        <span class="project-title">{project.title}</span>
                      </a>
                    ) : (
                      <span class="project-title">{project.title}</span>
                    )}
                  </h3>
                </div>
                <div class="flex flex-col justify-center">
                  <p class="text-base leading-relaxed text-ink-muted md:text-lg">
                    {project.description}
                  </p>
                  <ul class="mt-5 flex flex-wrap gap-x-5 gap-y-2" aria-label="Technologies">
                    {project.tags.map((tag) => (
                      <li class="text-sm text-ink">{tag}</li>
                    ))}
                  </ul>
                  {(project.repo || project.link) && (
                    <div class="mt-6 flex flex-wrap gap-5 text-sm font-semibold">
                      {project.link && project.link !== "#" && (
                        <a href={project.link} class="link-underline font-semibold">
                          Live demo
                        </a>
                      )}
                      {project.repo && project.repo !== "#" && (
                        <a href={project.repo} class="link-underline font-semibold">
                          Source
                        </a>
                      )}
                    </div>
                  )}
                </div>
              </article>
            </li>
          ))}
        </ul>
      </div>
    </section>
  )
}
