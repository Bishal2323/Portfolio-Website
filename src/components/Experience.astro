---
import { experience } from "../data/experience";
---

<section
  id="experience"
  class="border-t border-line/60 py-20 md:py-28"
  aria-labelledby="experience-heading"
>
  <div class="mx-auto max-w-5xl px-6 md:px-8">
    <div class="reveal">
      <h2
        id="experience-heading"
        class="font-display text-sm font-semibold uppercase tracking-[0.18em] text-bloom"
      >
        Experience
      </h2>
      <p class="mt-4 max-w-lg text-base text-ink-muted md:text-lg">
        Roles beyond the editor — communication, design, and campus leadership.
      </p>
    </div>

    <ul class="mt-14 space-y-0">
      {
        experience.map((item, index) => (
          <li
            class="reveal border-t border-line/70 py-8 first:border-t-0 first:pt-0 md:py-10"
            style={`transition-delay: ${index * 80}ms`}
          >
            <div class="grid gap-3 md:grid-cols-[minmax(0,0.9fr)_minmax(0,1.4fr)] md:gap-12">
              <div>
                <h3 class="font-display text-xl font-bold tracking-tight text-ink md:text-2xl">
                  {item.role}
                </h3>
                <p class="mt-1 text-sm font-semibold text-bloom">{item.org}</p>
              </div>
              <p class="text-base leading-relaxed text-ink-muted md:text-lg">{item.detail}</p>
            </div>
          </li>
        ))
      }
    </ul>
  </div>
</section>
