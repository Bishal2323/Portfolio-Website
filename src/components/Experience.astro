---
import { experience, hackathons, certificates } from "../data/experience";
---

<section
  id="experience"
  class="border-t border-line/60 py-20 md:py-28"
  aria-labelledby="experience-heading"
>
  <div class="mx-auto max-w-5xl px-6 md:px-8">
    <div class="reveal">
      <h2
        id="experience-heading"
        class="font-display text-sm font-semibold uppercase tracking-[0.18em] text-bloom"
      >
        Experience
      </h2>
      <p class="mt-4 max-w-lg text-base text-ink-muted md:text-lg">
        Roles beyond the editor — communication, design, and campus leadership.
      </p>
    </div>

    <ul class="mt-14 space-y-0">
      {
        experience.map((item, index) => (
          <li
            class="reveal border-t border-line/70 py-8 first:border-t-0 first:pt-0 md:py-10"
            style={`transition-delay: ${index * 80}ms`}
          >
            <div class="grid gap-3 md:grid-cols-[minmax(0,0.9fr)_minmax(0,1.4fr)] md:gap-12">
              <div>
                <h3 class="font-display text-xl font-bold tracking-tight text-ink md:text-2xl">
                  {item.role}
                </h3>
                <p class="mt-1 text-sm font-semibold text-bloom">{item.org}</p>
              </div>
              <p class="text-base leading-relaxed text-ink-muted md:text-lg">{item.detail}</p>
            </div>
          </li>
        ))
      }
    </ul>

    <!-- Hackathons -->
    <div class="reveal mt-20 border-t border-line/60 pt-16">
      <h3
        class="font-display text-sm font-semibold uppercase tracking-[0.18em] text-bloom"
      >
        Hackathons
      </h3>
      <p class="mt-4 max-w-lg text-base text-ink-muted md:text-lg">
        Campus competitions — tap a card to view the certificate.
      </p>

      <ul class="mt-10 grid gap-5 sm:grid-cols-2">
        {
          hackathons.map((item) => (
            <li>
              <button
                type="button"
                class="hackathon-card group w-full text-left"
                data-certificate-src={item.certificate}
                data-certificate-alt={item.certificateAlt}
                data-certificate-title={`${item.title} — ${item.event}`}
                aria-haspopup="dialog"
              >
                <div class="hackathon-card__media">
                  <img
                    src={item.certificate}
                    alt=""
                    loading="lazy"
                    class="hackathon-card__thumb"
                  />
                  <span class="hackathon-card__view">View certificate</span>
                </div>
                <div class="hackathon-card__body">
                  <p class="font-display text-xs font-semibold uppercase tracking-[0.16em] text-bloom">
                    {item.title}
                  </p>
                  <h4 class="mt-2 font-display text-xl font-bold tracking-tight text-ink">
                    {item.event}
                  </h4>
                  <p class="mt-1 text-sm font-semibold text-ink-muted">
                    {item.date} · {item.place}
                  </p>
                  <p class="mt-3 text-sm leading-relaxed text-ink-muted">{item.detail}</p>
                </div>
              </button>
            </li>
          ))
        }
      </ul>
    </div>

    <!-- Certificates -->
    <div class="reveal mt-20 border-t border-line/60 pt-16">
      <h3
        class="font-display text-sm font-semibold uppercase tracking-[0.18em] text-bloom"
      >
        Certificates
      </h3>

      <ul class="mt-10 grid gap-5 sm:grid-cols-2">
        {
          certificates.map((item) => (
            <li>
              <button
                type="button"
                class="hackathon-card group w-full text-left"
                data-certificate-src={item.certificate}
                data-certificate-alt={item.certificateAlt}
                data-certificate-title={item.title}
                aria-haspopup="dialog"
              >
                <div class="hackathon-card__media">
                  <img
                    src={item.certificate}
                    alt=""
                    loading="lazy"
                    class="hackathon-card__thumb"
                  />
                  <span class="hackathon-card__view">View certificate</span>
                </div>
                <div class="hackathon-card__body">
                  <h4 class="font-display text-xl font-bold tracking-tight text-ink">
                    {item.title}
                  </h4>
                </div>
              </button>
            </li>
          ))
        }
      </ul>
    </div>
  </div>
</section>

<!-- Certificate lightbox -->
<div
  id="certificate-modal"
  class="certificate-modal"
  hidden
  role="dialog"
  aria-modal="true"
  aria-labelledby="certificate-modal-title"
>
  <div class="certificate-modal__backdrop" data-close-certificate></div>
  <div class="certificate-modal__panel">
    <div class="certificate-modal__top">
      <h3 id="certificate-modal-title" class="certificate-modal__title"></h3>
      <button
        type="button"
        class="certificate-modal__close"
        data-close-certificate
        aria-label="Close certificate"
      >
        Close
      </button>
    </div>
    <img
      id="certificate-modal-image"
      class="certificate-modal__image"
      src=""
      alt=""
    />
  </div>
</div>

<style is:global>
  .hackathon-card {
    display: flex;
    flex-direction: column;
    overflow: hidden;
    border: 1px solid color-mix(in srgb, var(--color-line) 80%, transparent);
    background: color-mix(in srgb, white 88%, var(--color-mist-warm));
    border-radius: 0.85rem;
    cursor: pointer;
    transition:
      transform 0.2s ease,
      box-shadow 0.2s ease,
      border-color 0.2s ease;
  }

  .hackathon-card:hover,
  .hackathon-card:focus-visible {
    transform: translateY(-3px);
    border-color: color-mix(in srgb, var(--color-bloom) 45%, var(--color-line));
    box-shadow: 0 16px 36px rgba(18, 24, 32, 0.1);
    outline: none;
  }

  .hackathon-card__media {
    position: relative;
    aspect-ratio: 16 / 10;
    overflow: hidden;
    background: var(--color-mist);
  }

  .hackathon-card__thumb {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center top;
    transition: transform 0.35s ease;
  }

  .hackathon-card:hover .hackathon-card__thumb {
    transform: scale(1.03);
  }

  .hackathon-card__view {
    position: absolute;
    inset: auto 0.75rem 0.75rem auto;
    padding: 0.4rem 0.7rem;
    border-radius: 999px;
    background: color-mix(in srgb, var(--color-ink) 82%, transparent);
    color: white;
    font-family: var(--font-display);
    font-size: 0.7rem;
    font-weight: 650;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    opacity: 0;
    transform: translateY(4px);
    transition: opacity 0.2s ease, transform 0.2s ease;
  }

  .hackathon-card:hover .hackathon-card__view,
  .hackathon-card:focus-visible .hackathon-card__view {
    opacity: 1;
    transform: translateY(0);
  }

  .hackathon-card__body {
    padding: 1.1rem 1.15rem 1.25rem;
  }

  .certificate-modal[hidden] {
    display: none;
  }

  .certificate-modal {
    position: fixed;
    inset: 0;
    z-index: 80;
    display: grid;
    place-items: center;
    padding: 1.25rem;
  }

  .certificate-modal__backdrop {
    position: absolute;
    inset: 0;
    background: rgba(18, 24, 32, 0.62);
    backdrop-filter: blur(6px);
  }

  .certificate-modal__panel {
    position: relative;
    z-index: 1;
    width: min(920px, 100%);
    max-height: min(90vh, 900px);
    overflow: auto;
    border-radius: 0.9rem;
    background: color-mix(in srgb, white 94%, var(--color-mist-warm));
    border: 1px solid color-mix(in srgb, var(--color-line) 70%, transparent);
    box-shadow: 0 24px 60px rgba(18, 24, 32, 0.28);
    padding: 1rem 1rem 1.25rem;
  }

  .certificate-modal__top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    margin-bottom: 0.85rem;
  }

  .certificate-modal__title {
    margin: 0;
    font-family: var(--font-display);
    font-size: 1rem;
    font-weight: 700;
    color: var(--color-ink);
  }

  .certificate-modal__close {
    border: 1px solid var(--color-line);
    background: white;
    color: var(--color-ink);
    font-family: var(--font-display);
    font-size: 0.72rem;
    font-weight: 650;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    padding: 0.5rem 0.8rem;
    border-radius: 0.45rem;
    cursor: pointer;
  }

  .certificate-modal__close:hover {
    border-color: var(--color-bloom);
    color: var(--color-bloom-deep);
  }

  .certificate-modal__image {
    display: block;
    width: 100%;
    height: auto;
    border-radius: 0.5rem;
  }
</style>

<script>
  const modal = document.getElementById("certificate-modal");
  const modalImage = document.getElementById("certificate-modal-image") as HTMLImageElement | null;
  const modalTitle = document.getElementById("certificate-modal-title");

  function openCertificate(src: string, alt: string, title: string) {
    if (!modal || !modalImage || !modalTitle) return;
    modalImage.src = src;
    modalImage.alt = alt;
    modalTitle.textContent = title;
    modal.hidden = false;
    document.body.style.overflow = "hidden";
  }

  function closeCertificate() {
    if (!modal || !modalImage) return;
    modal.hidden = true;
    modalImage.src = "";
    document.body.style.overflow = "";
  }

  document.querySelectorAll<HTMLButtonElement>(".hackathon-card").forEach((btn) => {
    btn.addEventListener("click", () => {
      openCertificate(
        btn.dataset.certificateSrc || "",
        btn.dataset.certificateAlt || "",
        btn.dataset.certificateTitle || "Certificate",
      );
    });
  });

  document.querySelectorAll("[data-close-certificate]").forEach((el) => {
    el.addEventListener("click", () => closeCertificate());
  });

  document.addEventListener("keydown", (e) => {
    if (e.key === "Escape" && modal && !modal.hidden) closeCertificate();
  });
</script>
