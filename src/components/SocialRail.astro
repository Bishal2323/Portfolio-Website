---
import { site } from "../data/site";

const links = [
  {
    label: "X (Twitter)",
    href: site.x,
    icon: "x",
  },
  {
    label: "GitHub",
    href: site.github,
    icon: "github",
  },
  {
    label: "LinkedIn",
    href: site.linkedin,
    icon: "linkedin",
  },
].filter((link) => link.href && link.href !== "#");
---

{
  links.length > 0 && (
    <aside class="social-rail" aria-label="Social links">
      <ul class="social-rail__list">
        {links.map((link) => (
          <li>
            <a
              href={link.href}
              class="social-rail__link"
              target="_blank"
              rel="noopener noreferrer"
              aria-label={link.label}
              title={link.label}
            >
              {link.icon === "x" && (
                <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                  <path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-4.714-6.231-5.401 6.231H2.744l7.727-8.835L1.254 2.25H8.08l4.253 5.622L18.244 2.25zm-1.161 17.52h1.833L7.084 4.126H5.117L17.083 19.77z" />
                </svg>
              )}
              {link.icon === "github" && (
                <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                  <path d="M12 2a10 10 0 0 0-3.16 19.49c.5.09.68-.22.68-.48v-1.7c-2.78.6-3.37-1.2-3.37-1.2-.45-1.15-1.1-1.46-1.1-1.46-.9-.62.07-.6.07-.6 1 .07 1.52 1.03 1.52 1.03.89 1.53 2.34 1.09 2.91.83.09-.65.35-1.09.63-1.34-2.22-.25-4.55-1.11-4.55-4.94a3.86 3.86 0 0 1 1.03-2.68 3.6 3.6 0 0 1 .1-2.64s.84-.27 2.75 1.02a9.5 9.5 0 0 1 5 0c1.91-1.29 2.75-1.02 2.75-1.02.38.85.4 1.82.1 2.64a3.86 3.86 0 0 1 1.03 2.68c0 3.84-2.34 4.68-4.57 4.93.36.31.68.92.68 1.86v2.76c0 .27.18.58.69.48A10 10 0 0 0 12 2z" />
                </svg>
              )}
              {link.icon === "linkedin" && (
                <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                  <path d="M4.98 3.5A2.5 2.5 0 1 1 2.5 6a2.5 2.5 0 0 1 2.48-2.5zM3 8.75h3.96V21H3V8.75zM9.34 8.75H13.1v1.67h.05c.52-.98 1.8-2.02 3.7-2.02 3.96 0 4.69 2.6 4.69 6V21h-3.96v-5.5c0-1.31-.02-3-1.83-3-1.83 0-2.11 1.43-2.11 2.9V21H9.34V8.75z" />
                </svg>
              )}
            </a>
          </li>
        ))}
      </ul>
      <span class="social-rail__line" aria-hidden="true"></span>
    </aside>
  )
}

<style>
  .social-rail {
    position: fixed;
    right: 1.35rem;
    bottom: 0;
    z-index: 25;
    display: none;
    flex-direction: column;
    align-items: center;
    gap: 0;
    /* Leave room above Chill button */
    padding-bottom: 5.75rem;
  }

  @media (min-width: 768px) {
    .social-rail {
      display: flex;
      right: 1.6rem;
    }
  }

  .social-rail__list {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 1rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .social-rail__link {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 1.75rem;
    height: 1.75rem;
    color: var(--color-ink);
    opacity: 0.72;
    transition:
      opacity 0.25s ease,
      transform 0.25s cubic-bezier(0.22, 1, 0.36, 1);
  }

  .social-rail__link:hover,
  .social-rail__link:focus-visible {
    opacity: 1;
    transform: translateY(-2px);
  }

  .social-rail__link:focus-visible {
    outline: 2px solid var(--color-ink);
    outline-offset: 3px;
  }

  .social-rail__line {
    display: block;
    width: 1px;
    height: 4.5rem;
    margin-top: 1rem;
    background: var(--color-ink);
    opacity: 0.35;
  }
</style>
