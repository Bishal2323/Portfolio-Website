---
import { site } from "../data/site";

const links = [
  { href: "#about", label: "About" },
  { href: "#projects", label: "Projects" },
  { href: "#experience", label: "Experience" },
  { href: "#contact", label: "Contact" },
];
---

<header class="absolute inset-x-0 top-0 z-20">
  <nav
    class="mx-auto flex max-w-5xl items-center justify-between px-6 py-5 md:px-8"
    aria-label="Primary"
  >
    <a
      href="#top"
      class="font-display text-sm font-semibold tracking-tight text-ink transition-colors hover:text-bloom"
    >
      {site.name.split(" ")[0]}
    </a>
    <ul class="flex flex-wrap items-center justify-end gap-x-4 gap-y-1 text-sm text-ink-muted md:gap-x-8">
      {
        links.map((link) => (
          <li>
            <a
              href={link.href}
              class="transition-colors hover:text-ink focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-bloom"
            >
              {link.label}
            </a>
          </li>
        ))
      }
    </ul>
  </nav>
</header>
