---
import { site } from "../data/site";
---

<section
  id="contact"
  class="border-t border-line/60 py-20 md:py-28"
  aria-labelledby="contact-heading"
>
  <div class="reveal mx-auto max-w-5xl px-6 md:px-8">
    <h2
      id="contact-heading"
      class="font-display text-sm font-semibold uppercase tracking-[0.18em] text-ink-muted"
    >
      Contact
    </h2>
    <p
      class="mt-6 max-w-xl font-display text-2xl font-semibold leading-snug tracking-tight text-ink md:text-3xl"
    >
      Want to collaborate, ask about a project, or just say hello?
    </p>
    <div class="mt-10 flex flex-wrap items-center gap-8">
      <a href={site.email} class="btn-ink">Email me</a>
      <a
        href={site.github}
        target="_blank"
        rel="noopener noreferrer"
        class="link-underline font-display text-sm font-semibold"
      >
        GitHub
      </a>
      <a
        href={site.linkedin}
        target="_blank"
        rel="noopener noreferrer"
        class="link-underline font-display text-sm font-semibold"
      >
        LinkedIn
      </a>
    </div>
  </div>
</section>

<footer class="border-t border-line/60 py-8">
  <div
    class="mx-auto flex max-w-5xl flex-col gap-2 px-6 text-sm text-ink-muted md:flex-row md:items-center md:justify-between md:px-8"
  >
    <p class="font-display font-semibold text-ink">{site.name}</p>
    <p>
      CS student & software developer · Building with {site.stack.join(", ")}
    </p>
  </div>
</footer>
