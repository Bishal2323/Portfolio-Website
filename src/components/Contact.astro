---
import { site } from "../data/site";
---

<section
  id="contact"
  class="border-t border-line/60 py-20 md:py-28"
  aria-labelledby="contact-heading"
>
  <div class="reveal mx-auto max-w-5xl px-6 md:px-8">
    <h2
      id="contact-heading"
      class="font-display text-sm font-semibold uppercase tracking-[0.18em] text-bloom"
    >
      Contact
    </h2>
    <p
      class="mt-6 max-w-xl font-display text-2xl font-semibold leading-snug tracking-tight text-ink md:text-3xl"
    >
      Want to collaborate, ask about a project, or just say hello?
    </p>
    <div class="mt-10 flex flex-wrap items-center gap-6">
      <a
        data-content="contact-email"
        href={site.email}
        class="inline-flex items-center justify-center bg-bloom px-6 py-3 font-display text-sm font-semibold text-white transition-colors hover:bg-bloom-deep focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-bloom"
      >
        Email me
      </a>
      <a
        data-content="contact-github"
        href={site.github}
        target="_blank"
        rel="noopener noreferrer"
        class="font-display text-sm font-semibold text-ink transition-colors hover:text-bloom focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-bloom"
      >
        GitHub
      </a>
      <a
        data-content="contact-linkedin"
        href={site.linkedin}
        target="_blank"
        rel="noopener noreferrer"
        class="font-display text-sm font-semibold text-ink transition-colors hover:text-bloom focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-bloom"
      >
        LinkedIn
      </a>
    </div>
  </div>
</section>

<footer class="border-t border-line/60 py-8">
  <div
    class="mx-auto flex max-w-5xl flex-col gap-2 px-6 text-sm text-ink-muted md:flex-row md:items-center md:justify-between md:px-8"
  >
    <p data-content="footer-name" class="font-display font-semibold text-ink">{site.name}</p>
    <p data-content="footer-stack">
      CS student & software developer · Building with {site.stack.join(", ")}
    </p>
  </div>
</footer>
